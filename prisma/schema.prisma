generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  user_id       Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  phone         String    @unique
  password_hash String
  role          Role      @default(CUSTOMER)
  created_at    DateTime  @default(now())
  admin         Admin?
  customer      Customer?

  @@map("users")
}

model Customer {
  customer_id     Int           @id @default(autoincrement())
  user_id         Int           @unique
  gender          String?
  profile_picture String?
  appointments    Appointment[]
  user            User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  loyalty         Loyalty?

  @@map("customers")
}

model Admin {
  admin_id          Int               @id @default(autoincrement())
  user_id           Int               @unique
  admin_username    String            @unique
  user              User              @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  salon_settings    SalonSettings?
  services          Service[]
  offers            Offer[]
  working_hours     WorkingHours[]
  breaks            Break[]
  unavailable_dates UnavailableDate[]
  time_slots        TimeSlot[]

  @@map("admins")
}

model Service {
  service_id   Int           @id @default(autoincrement())
  service_name String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  gender       String
  duration     Int
  status       String        @default("Active")
  image        String?
  admin_id     Int
  admin        Admin         @relation(fields: [admin_id], references: [admin_id])
  appointments Appointment[]

  @@map("services")
}

model SalonSettings {
  setting_id      Int     @id @default(autoincrement())
  salon_name      String
  address         String
  contact_details String
  location        String?
  admin_id        Int     @unique
  admin           Admin   @relation(fields: [admin_id], references: [admin_id])

  @@map("salon_settings")
}

model Stylist {
  stylist_id     Int           @id @default(autoincrement())
  name           String
  gender         String
  specialization String
  status         String        @default("Active")
  appointments   Appointment[]
  time_slots     TimeSlot[]

  @@map("stylists")
}

model TimeSlot {
  time_slot_id Int      @id @default(autoincrement())
  stylist_id   Int
  date         DateTime @db.Date
  start_time   DateTime
  end_time     DateTime
  status       String   @default("Available")
  admin_id     Int
  admin        Admin    @relation(fields: [admin_id], references: [admin_id])
  stylist      Stylist  @relation(fields: [stylist_id], references: [stylist_id], onDelete: Cascade)

  @@map("time_slots")
}

model WorkingHours {
  working_hours_id Int      @id @default(autoincrement())
  day              String
  opening_time     DateTime
  closing_time     DateTime
  status           String   @default("Open")
  admin_id         Int
  admin            Admin    @relation(fields: [admin_id], references: [admin_id])

  @@map("working_hours")
}

model Break {
  break_id   Int      @id @default(autoincrement())
  day        String
  start_time DateTime
  end_time   DateTime
  reason     String?
  status     String   @default("Active")
  admin_id   Int
  admin      Admin    @relation(fields: [admin_id], references: [admin_id])

  @@map("breaks")
}

model UnavailableDate {
  unavailable_date_id Int      @id @default(autoincrement())
  date                DateTime @db.Date
  reason              String
  status              String   @default("Closed")
  admin_id            Int
  admin               Admin    @relation(fields: [admin_id], references: [admin_id])

  @@map("unavailable_dates")
}

model Appointment {
  appointment_id Int      @id @default(autoincrement())
  customer_id    Int
  service_id     Int
  stylist_id     Int
  date           DateTime @db.Date
  time           DateTime
  stylist_type   String?
  status         String   @default("Pending")
  created_date   DateTime @default(now())
  customer       Customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  service        Service  @relation(fields: [service_id], references: [service_id])
  stylist        Stylist  @relation(fields: [stylist_id], references: [stylist_id])

  @@map("appointments")
}

model Offer {
  offer_id    Int      @id @default(autoincrement())
  title       String
  description String?
  discount    Decimal  @db.Decimal(5, 2)
  start_date  DateTime @db.Date
  end_date    DateTime @db.Date
  status      String   @default("Active")
  admin_id    Int
  admin       Admin    @relation(fields: [admin_id], references: [admin_id])

  @@map("offers")
}

model Loyalty {
  loyalty_id          Int      @id @default(autoincrement())
  customer_id         Int      @unique
  points              Int      @default(0)
  reward_info         String?
  transaction_history String?
  customer            Customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)

  @@map("loyalty")
}

enum Role {
  CUSTOMER
  ADMIN
}